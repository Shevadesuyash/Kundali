# ===========================================================================
# Kundali Milan Suite Backend — Environment Configuration
# ===========================================================================
# REQUIRED: Google Gemini API key for AI Astrologer Bot
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_gemini_api_key_here

# OPTIONAL (Supabase PostgreSQL): Leave empty to use local SQLite fallback.
# Get your connection string from: Supabase → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OPTIONAL (Supabase JWT Secret): Used to verify Supabase JWT token signatures.
# Get from: Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# OPTIONAL: Custom SQLite database path (default: profiles.db in project root)
# KUNDALI_DB_PATH=./profiles.db

# OPTIONAL: Manglik calculation mode
# STANDARD (default): Houses 1,4,7,8,12  |  SOUTH: Houses 1,2,4,7,8,12
# MANGLIK_MODE=STANDARD

# OPTIONAL: Lunar node mode. TRUE (default) or MEAN
# NODE_MODE=TRUE

